# === Amara — variables de entorno ===
# Copia este archivo a .env.local y pon tus claves. Sin claves, la app corre en modo DEMO.

# Grok (xAI) — el proveedor grande tolerante con ficción adulta.
# Consigue la clave en https://x.ai/api
XAI_API_KEY=
XAI_MODEL=grok-4

# DeepSeek vía OpenRouter — el caballo de batalla (potente + barato + pesos MIT).
# Consigue la clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# URL pública de la app (para headers de OpenRouter). Opcional.
APP_URL=http://localhost:3000

# Carpeta de datos de sesión (memoria v1). Opcional.
AMARA_DATA_DIR=.data
