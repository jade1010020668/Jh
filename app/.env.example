# === Amara — variables de entorno ===
# Copia este archivo a .env.local y pon tus claves. Sin claves, la app corre en modo DEMO.
#
# MÍNIMO PARA QUE FUNCIONE DE VERDAD: solo OPENROUTER_API_KEY.
# Con esa sola llave la app usa modelos GRATUITOS ($0) automáticamente.

# ---- LO ÚNICO OBLIGATORIO ----
# OpenRouter: crea cuenta y llave en https://openrouter.ai/keys (la llave es gratis).
# La app detecta sola los modelos de costo $0 y elige el mejor disponible.
OPENROUTER_API_KEY=

# ---- OPCIONALES ----
# Modelo de pago (mejor calidad). Si lo dejas vacío, se usa el plan gratuito.
OPENROUTER_MODEL=deepseek/deepseek-chat
# Modelo gratuito de respaldo si no se puede consultar el catálogo en vivo.
OPENROUTER_FREE_MODEL=

# Grok (xAI) — el proveedor grande tolerante con ficción adulta. De pago.
# Consigue la clave en https://x.ai/api
XAI_API_KEY=
XAI_MODEL=grok-4

# URL pública de la app (para headers de OpenRouter). Opcional.
APP_URL=http://localhost:3000

# Base de datos. Si la defines, usa Postgres (producción: Neon/Supabase, gratis).
# Si la dejas vacía, usa un driver local en .data/ (sandbox/desarrollo).
# Ejemplo Neon: postgres://user:pass@ep-xxx.neon.tech/db?sslmode=require
DATABASE_URL=

# Secreto para firmar sesiones. CAMBIA esto en producción (cadena larga y aleatoria).
AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Generación de imágenes (toleran contenido adulto — docs/02 §3). Opcional.
NOVITA_API_KEY=
MODELSLAB_API_KEY=

# Voz (TTS). Sin llave, la app habla con la voz del dispositivo (demo, $0).
# En producción el core NSFW va con TTS self-hosted (Chatterbox/Qwen3) — docs/02 §2.
ELEVENLABS_API_KEY=

# Carpeta de datos del driver local (si no usas Postgres). Opcional.
AMARA_DATA_DIR=.data
