# ===== Anthropic (análisis con IA) =====
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# ===== Proveedor de envío de WhatsApp =====
# "meta"   → WhatsApp Cloud API de Meta (GRATIS, oficial). Recomendado.
# "twilio" → Twilio (sandbox gratis para pruebas).
WHATSAPP_PROVIDER=meta

# ===== Destinatario (solo dígitos con código de país) =====
WHATSAPP_TO=573183938822

# ===== Opción A: Meta WhatsApp Cloud API =====
# Los sacas gratis en https://developers.facebook.com (ver README).
META_ACCESS_TOKEN=EAAG...
META_PHONE_NUMBER_ID=123456789012345

# ===== Opción B: Twilio (solo si WHATSAPP_PROVIDER=twilio) =====
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ===== Programación =====
LEAD_MINUTES=60
CRON_SCHEDULE=*/5 * * * *
