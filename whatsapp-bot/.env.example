# ===== Ligas a seguir (separadas por coma) =====
# col.1 = Liga BetPlay · eng.1 = Premier · esp.1 = LaLiga · ita.1 = Serie A · ger.1 = Bundesliga · fra.1 = Ligue 1
# conmebol.libertadores · conmebol.sudamericana · uefa.champions · uefa.europa
LEAGUES=col.1

# ===== Envío por WhatsApp =====
# "meta"   → WhatsApp Cloud API de Meta (gratis, oficial). Recomendado.
# "twilio" → Twilio (sandbox gratis para pruebas).
WHATSAPP_PROVIDER=meta
# Destinatario: solo dígitos, con código de país (57 para Colombia)
WHATSAPP_TO=57XXXXXXXXXX

# Opción A: Meta WhatsApp Cloud API (https://developers.facebook.com, ver README)
META_ACCESS_TOKEN=EAAG...
META_PHONE_NUMBER_ID=123456789012345

# Opción B: Twilio (solo si WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ===== Programación =====
LEAD_MINUTES=60
CRON_SCHEDULE=*/5 * * * *
TIMEZONE=America/Bogota

# ===== IA (OPCIONAL) =====
# Sin esta clave el bot envía el pronóstico estadístico, que no cuesta nada.
# Con ella, además busca bajas y rotaciones confirmadas (unos centavos de dólar por partido).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
