# ===== Anthropic (análisis con IA) =====
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# ===== Twilio (envío de WhatsApp) =====
# Encuéntralos en https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Número del sandbox de WhatsApp de Twilio (por defecto el de pruebas de Twilio).
# En producción, reemplázalo por tu número de WhatsApp Business aprobado.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ===== Destinatario =====
WHATSAPP_TO=whatsapp:+573183938822

# ===== Programación =====
# Minutos antes del partido para enviar el pronóstico.
LEAD_MINUTES=60
# Cada cuánto revisa la agenda (formato cron). Por defecto cada 5 minutos.
CRON_SCHEDULE=*/5 * * * *
